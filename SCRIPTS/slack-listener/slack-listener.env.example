# Slack app credentials. Keep the real file only at /etc/qimono/slack-listener.env.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# The Qimono Slack workspace and the one author whose messages are captured.
SLACK_WORKSPACE_URL=https://qimono.slack.com
SLACK_CHANNEL_ID=C0CD1U79YTH
SLACK_ALLOWED_USER_ID=U04DXT85LS1

# Fine-grained GitHub token: only qimono-repos/the-porketo, Contents and Pull
# requests read/write (the latter posts the optional reactive wake marker).
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=qimono-repos/the-porketo
GITHUB_BRANCH=trunk
# Optional: the permanent bridge PR used to wake ChatGPT immediately.
GITHUB_TRIGGER_PR=
LOG_LEVEL=INFO
